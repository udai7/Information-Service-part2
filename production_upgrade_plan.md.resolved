## 4. Database Schema Redesign

### New Models to Add

```prisma
// ─── NEW: Department Model ───
model Department {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  code            String   @unique  // e.g., "POL", "REV"
  description     String?
  contactEmail    String?
  contactPhone    String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  admins              Admin[]
  schemeServices      SchemeService[]
  certificateServices CertificateService[]
  contactServices     ContactService[]
  grievances          Grievance[]
  feedbacks           Feedback[]
}

// ─── NEW: Audit Log ───
model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String   // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity     String   // Admin, SchemeService, Grievance, etc.
  entityId   Int?
  details    Json?    // What changed (old value → new value)
  ipAddress  String?
  userAgent  String?
  adminId    Int?
  admin      Admin?   @relation(fields: [adminId], references: [id])
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ─── NEW: Session Management (for token revocation) ───
model Session {
  id        String   @id @default(uuid())
  adminId   Int
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  isActive  Boolean  @default(true)

  @@index([adminId])
  @@index([token])
  @@index([expiresAt])
}

// ─── NEW: Notification System ───
model Notification {
  id        Int      @id @default(autoincrement())
  adminId   Int
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // grievance_new, feedback_new, escalation, system
  isRead    Boolean  @default(false)
  link      String?  // Deep link to the relevant page
  createdAt DateTime @default(now())

  @@index([adminId, isRead])
}

// ─── NEW: Grievance Activity Log ───
model GrievanceActivity {
  id          Int      @id @default(autoincrement())
  grievanceId Int
  grievance   Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  action      String   // status_change, assigned, note_added, escalated
  fromValue   String?
  toValue     String?
  note        String?
  performedBy String?  // Admin name
  adminId     Int?
  createdAt   DateTime @default(now())

  @@index([grievanceId])
}
```

### Modified Existing Models

```diff
model Admin {
   id        Int      @id @default(autoincrement())
   email     String   @unique
   password  String
   name      String
-  role      String   @default("admin")
+  role      String   @default("department_admin") // "super_admin" | "department_admin"
+  phone     String?
+  isActive  Boolean  @default(true)
+  lastLogin DateTime?
+  loginAttempts Int   @default(0)
+  lockedUntil DateTime?
   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt

+  // Department relation
+  departmentId Int?
+  department   Department? @relation(fields: [departmentId], references: [id])

   schemeServices      SchemeService[]
   certificateServices CertificateService[]
   contactServices     ContactService[]
+  auditLogs           AuditLog[]
+  sessions            Session[]
+  notifications       Notification[]
}

model Grievance {
   // ... existing fields ...
+  departmentId  Int?
+  department    Department?  @relation(fields: [departmentId], references: [id])
+  activities    GrievanceActivity[]
+  escalatedAt   DateTime?
+  escalatedTo   String?    // SuperAdmin or higher department
+  slaDeadline   DateTime?  // Auto-calculated SLA
+  responseCount Int        @default(0)
   // ... rest stays ...
}

model Feedback {
   // ... existing fields ...
+  departmentId Int?
+  department   Department? @relation(fields: [departmentId], references: [id])
}

model SchemeService {
   // ... existing fields ...
+  departmentId Int?
+  department   Department? @relation(fields: [departmentId], references: [id])
}

model CertificateService {
   // ... existing fields ...
+  departmentId Int?
+  department   Department? @relation(fields: [departmentId], references: [id])
}

model ContactService {
   // ... existing fields ...
+  departmentId Int?
+  department   Department? @relation(fields: [departmentId], references: [id])
}
```

### Database Indexes for Performance at Scale

```prisma
// Add to schema.prisma for 4M user performance
@@index([status, departmentId])     // on Grievance
@@index([status, departmentId])     // on Feedback
@@index([status, isActive])         // on all Service models
@@index([departmentId, status])     // on all Service models
@@index([createdAt])                // on Grievance, Feedback
@@index([trackingId])               // on Grievance (already unique)
@@index([email])                    // on Grievance, Feedback (for user lookups)
```

